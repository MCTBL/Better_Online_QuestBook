{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "outDir": "./bin/js",
        "rootDir": "./src",
        "moduleResolution": "nodenext",
        "strictPropertyInitialization": false,
        "types": ["jquery"]
    },
    "include": ["src/**/*"]
}
